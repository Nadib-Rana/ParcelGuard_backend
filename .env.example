# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=3000
APP_NAME="Nest Starter Template"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ==========================================
# Database Configuration (PostgreSQL + Prisma)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_starter_db?schema=public

# ==========================================
# Authentication & Security
# ==========================================
# Generate secure 64+ char random string: openssl rand -base64 32
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_12345
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_12345
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ==========================================
# Email Configuration (SMTP / Mailpit / Gmail)
# ==========================================
# For Local Dev with Mailpit (in docker-compose):
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME="Nest Starter Template"
MAIL_FROM_EMAIL=noreply@example.com

# For Production (e.g., SMTP / SendGrid / Resend / AWS SES):
# MAIL_HOST=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_USER=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_FROM_NAME="Your App"
# MAIL_FROM_EMAIL=notifications@yourdomain.com

# ==========================================
# Object Storage (MinIO / AWS S3)
# ==========================================
STORAGE_DRIVER=minio
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=nest-starter-uploads
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000/nest-starter-uploads

# For Production AWS S3:
# STORAGE_DRIVER=s3
# STORAGE_ENDPOINT=s3.amazonaws.com
# STORAGE_PORT=443
# STORAGE_USE_SSL=true
# STORAGE_ACCESS_KEY=your-aws-access-key-id
# STORAGE_SECRET_KEY=your-aws-secret-access-key
# STORAGE_BUCKET=your-production-bucket-name
# STORAGE_REGION=us-east-1
# STORAGE_PUBLIC_URL=https://your-production-bucket-name.s3.amazonaws.com

# ==========================================
# Swagger OpenAPI Documentation
# ==========================================
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
SWAGGER_TITLE="Nest Starter Template API"
SWAGGER_DESCRIPTION="Enterprise-grade NestJS RESTful API Starter Template with Prisma, JWT Auth, RBAC, Storage, Mail, and Docker"
SWAGGER_VERSION=1.0.0
